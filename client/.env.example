# ---------------------------------------------------------------------------
# Client environment. Copy to `client/.env` and adjust.
# Only variables prefixed with VITE_ are exposed to the browser bundle — never
# put a secret here.
# ---------------------------------------------------------------------------

# Base URL of the API, without a trailing slash.
VITE_API_URL=http://localhost:5000

# Public URL this client is served from, used for canonical links.
VITE_APP_URL=http://localhost:5173

# Set false to hide the landing page's "Try the demo" button. The API refuses the
# demo sign-in anyway when no demo account is seeded, so this only hides a button
# that would not work — it is not the enforcement.
VITE_DEMO_ENABLED=true

# Set true to show "Continue with Google" on sign-in and sign-up. Only once the
# API has GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET; otherwise the button leads
# back here with "not available".
VITE_GOOGLE_AUTH_ENABLED=false

# Optional cookieless analytics (Plausible/Umami). Leaving these unset adds no
# script and no cookie, which is why the privacy page needs no cookie banner.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SRC=

# Optional error reporting. Leave blank and the Sentry SDK is never downloaded:
# it sits behind a dynamic import only reached when this is set, so it costs the
# landing bundle nothing. When set, request cookies are stripped and the reported
# user is reduced to an id before anything is sent.
VITE_SENTRY_DSN=
