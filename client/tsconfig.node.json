{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "allowedHosts.ts"],
  "exclude": ["node_modules", "dist"]
}
