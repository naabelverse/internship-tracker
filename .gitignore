# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
*.tsbuildinfo

# database dumps from scripts/backup.sh — an archive of the production database
# is every user's data in one file, so it must never be committed
backups/
*.archive.gz

# test / coverage
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
.playwright/

# bundle analysis output (regenerate with `npm run analyze`)
bundle-report.html

# environment — never commit real secrets
.env
.env.*
!.env.example

# uploads (local storage driver only; production uses object storage)
uploads/
server/uploads/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# caches
.eslintcache
.vite/
.cache/

# local agent tooling artefacts, not part of the project
ruvector.db

# Generated on every client build from VITE_APP_URL by
# client/scripts/generateSeoFiles.mjs. Committing these is what put
# http://localhost:5173 into production: Vite copies public/ verbatim, so a
# committed copy can never pick up the deployment domain.
client/public/robots.txt
client/public/sitemap.xml
