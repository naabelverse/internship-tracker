{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "client/Dockerfile"
  },
  "deploy": {
    "startCommand": "npm run preview --workspace client -- --host --port ${PORT:-4173}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
