# ---------------------------------------------------------------------------
# Server environment. Copy to `server/.env` and fill in.
#
# Development needs only MONGO_URI, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET;
# everything else falls back to the defaults shown here.
#
# Production additionally requires: both JWT secrets at least 32 characters,
# different from each other, not the placeholder values below, and CLIENT_ORIGIN
# and APP_URL pointing at the deployed origins rather than localhost. The zod
# loader in src/config/env.ts refuses to boot otherwise.
#
# Generate a secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=5000

# MongoDB connection string (Atlas format: mongodb+srv://user:pass@cluster/db).
MONGO_URI=mongodb://127.0.0.1:27017/internship_tracker

# Signing secrets. Must be long, random, and different from one another.
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48

# Token lifetimes, in `ms`-style duration strings.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Browser origin allowed by CORS, and the public URL used in links we generate.
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# error | warn | info | http | debug
LOG_LEVEL=info

# Number of proxy hops to trust for client IPs. 0 locally, 1 behind Render/Railway.
TRUST_PROXY=0
