# ---------------------------------------------------------------------------
# Server environment. Copy to `server/.env` and fill in.
#
# Development needs only MONGO_URI, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET;
# everything else falls back to the defaults shown here.
#
# Production additionally requires: both JWT secrets at least 32 characters,
# different from each other, not the placeholder values below, and CLIENT_ORIGIN
# and APP_URL pointing at the deployed origins rather than localhost. The zod
# loader in src/config/env.ts refuses to boot otherwise.
#
# Generate a secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=5000

# MongoDB connection string (Atlas format: mongodb+srv://user:pass@cluster/db).
MONGO_URI=mongodb://127.0.0.1:27017/internship_tracker

# Signing secrets. Must be long, random, and different from one another.
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48

# Token lifetimes, in `ms`-style duration strings.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Browser origin allowed by CORS, and the public URL used in links we generate.
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Public origin of this API. Signed attachment download links are built from it,
# so it must be the address a browser can actually reach.
API_URL=http://localhost:5000

# error | warn | info | http | debug
LOG_LEVEL=info

# Number of proxy hops to trust for client IPs. 0 locally, 1 behind Render/Railway.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Uploads. Production must use s3: the free tier hosts wipe local disk on every
# redeploy, so anything written there is lost. The loader refuses to boot with
# STORAGE_DRIVER=local when NODE_ENV=production.
# ---------------------------------------------------------------------------

# local | s3
STORAGE_DRIVER=local

# Directory used by the local driver, relative to the server workspace.
UPLOAD_DIR=uploads

# Per-file upload ceiling in megabytes.
MAX_UPLOAD_MB=5

# Required when STORAGE_DRIVER=s3. Works with Cloudflare R2 and any
# S3-compatible endpoint; leave S3_ENDPOINT unset for AWS itself.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Demo account
#
# The account `npm run seed` creates and `npm run seed:reset` restores. These
# are published in the README on purpose: it is a throwaway account holding
# generated fixtures, not a real user. Change them if you expose the instance
# publicly and do not want the documented credentials to work.
# ---------------------------------------------------------------------------

DEMO_EMAIL=demo@tracker.dev
DEMO_PASSWORD=Demo@1234

# ---------------------------------------------------------------------------
# Reminders
# ---------------------------------------------------------------------------

# Local hour at which each user receives their digest. The cron ticks hourly in
# UTC and only selects users whose own clock currently reads this hour.
REMINDER_DIGEST_HOUR=8

# Set false to keep the scheduler off, which is what the test suite does.
ENABLE_CRON=true

# ---------------------------------------------------------------------------
# Transactional email
#
# Leave every SMTP_* value blank and the app falls back to a console transport
# that prints the whole message, including the verification link. That is a
# supported state, not a broken one: the app boots and registration works with
# no email configuration at all (SPEC section 13).
#
# Nodemailer speaks SMTP, and every provider below publishes an SMTP endpoint,
# so there is no provider-specific setup:
#   Resend    SMTP_HOST=smtp.resend.com     SMTP_PORT=587  SMTP_USER=resend
#   SendGrid  SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey
#   Mailgun   SMTP_HOST=smtp.mailgun.org    SMTP_PORT=587  SMTP_USER=postmaster@...
# In each case SMTP_PASS is the API key. Port 465 is treated as implicit TLS;
# 587 and 25 start in the clear and upgrade with STARTTLS.
# ---------------------------------------------------------------------------

# The From header. Use a domain you control, with a real display name, or your
# mail lands in spam. DEPLOYMENT.md covers the SPF/DKIM/DMARC records.
MAIL_FROM=Internship Tracker <no-reply@localhost>

# smtp | console. Leave blank to decide from whether SMTP_HOST is set below.
# Setting this to smtp without an SMTP_HOST refuses to boot, on purpose: it is
# the one combination that means "I believe mail is being delivered" when none
# of it can be.
MAIL_TRANSPORT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ISO weekday for the opt-in weekly summary: 1 Monday through 7 Sunday. It goes
# out at REMINDER_DIGEST_HOUR on that day, in each recipient's own timezone.
WEEKLY_SUMMARY_WEEKDAY=1
